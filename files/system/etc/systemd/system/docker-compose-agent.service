[Unit]
Description=Docker Compose - Clawdbot Agent Stack
Documentation=https://github.com/clawdbot/clawdbot
Requires=docker.service network-online.target
After=docker.service network-online.target
# Wait for NAS media mount (for health checks)
RequiresMountsFor=/mnt/nas-media

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/openclaw/agent/guardrail
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
